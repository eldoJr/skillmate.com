# App
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=8000

# Database (plain postgres:// — drizzle uses postgres.js)
DATABASE_URL=postgresql://user:password@localhost:5432/skillmate

# JWT
JWT_SECRET=your-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM=noreply@skillmate.com
EMAILS_FROM_NAME=Skillmate

# NVIDIA NIM (AI features)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NIM_EMBEDDING_DIMENSION=1024

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
