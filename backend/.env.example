# App
PROJECT_NAME=Skillmate
VERSION=0.1.0
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skillmate

# JWT
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM=noreply@skillmate.com
EMAILS_FROM_NAME=Skillmate

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NIM_EMBEDDING_DIMENSION=1024

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-key
